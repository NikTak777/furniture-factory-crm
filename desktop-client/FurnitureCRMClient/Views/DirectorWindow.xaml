<Window x:Class="FurnitureCRMClient.Views.DirectorWindow"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:local="clr-namespace:FurnitureCRMClient.Views"
            mc:Ignorable="d"
            Title="Панель Управления" Height="700" Width="1000"
            WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl Margin="10" Grid.Row="0">
            <TabItem Header="Учёт сотрудников">
                <ContentControl x:Name="EmployeeManagementContent" />
            </TabItem>
            <TabItem Header="Учёт номенклатуры">
                <ContentControl x:Name="NomenclatureManagementContent" />
            </TabItem>
            <TabItem Header="Анализ отчётов о производстве">
                <ContentControl x:Name="ProductionAnalysisContent" />
            </TabItem>
            <TabItem Header="Анализ продаж персонала">
                <ContentControl x:Name="StaffSalesAnalysisContent" />
            </TabItem>
        </TabControl>
        <Button Content="Выйти"
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Height="38"
                Margin="18,0,18,18"
                Click="LogoutButton_Click" />
    </Grid>
</Window>