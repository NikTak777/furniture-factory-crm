<Window x:Class="FurnitureCRMClient.Views.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Менеджер — CRM" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl Margin="10" Grid.Row="0">
            <TabItem Header="Просмотр номенклатуры">
                <ContentControl x:Name="NomenclatureTabContent" />
            </TabItem>
            <TabItem Header="Учёт заказов">
                <ContentControl x:Name="OrdersTabContent" />
            </TabItem>
            <TabItem Header="Учёт клиентов">
                <ContentControl x:Name="ClientsTabContent" />
            </TabItem>
            <TabItem Header="Отчёты о производстве">
                <ContentControl x:Name="ReportsTabContent" />
            </TabItem>
        </TabControl>
        <Button Content="Выйти"
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Height="38"
                Margin="18,0,18,18"
                Click="LogoutButton_Click" />
    </Grid>
</Window>