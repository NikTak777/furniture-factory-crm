<Window x:Class="FurnitureCRMClient.Views.EditStaffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FurnitureCRMClient.Views"
        mc:Ignorable="d"
        Title="Редактировать сотрудника" Height="350" Width="500"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style TargetType="TextBox">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                    <Setter Property="BorderBrush" Value="Red"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/> <!-- New row for Username -->
            <RowDefinition Height="Auto"/> <!-- New row for Password -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ФИО -->
        <Label Content="ФИО:" Grid.Row="0" Grid.Column="0"/>
        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,5">
            <TextBox Height="23"
                     Text="{Binding Staff.FullName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            <TextBlock Text="{Binding Errors[FullName]}" Foreground="Red" FontSize="10" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Должность -->
        <Label Content="Должность:" Grid.Row="1" Grid.Column="0"/>
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,5">
            <ComboBox Height="23"
                      ItemsSource="{Binding AllowedPositions}"
                      SelectedItem="{Binding Staff.Position, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                      IsEditable="False"/>
            <TextBlock Text="{Binding Errors[Position]}" Foreground="Red" FontSize="10" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Логин -->
        <Label Content="Логин:" Grid.Row="2" Grid.Column="0"/>
        <Grid Grid.Row="2" Grid.Column="1" Margin="0,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Row="0" Grid.Column="0"
                     Height="23"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            <Button Grid.Row="0" Grid.Column="1"
                    Content="Перегенерировать" 
                    Command="{Binding RegenerateUsernameCommand}" 
                    Width="120" 
                    Height="23" 
                    Margin="5,0,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="{Binding Errors[Username]}" 
                       Foreground="Red" 
                       FontSize="10" 
                       Margin="0,2,0,0"
                       HorizontalAlignment="Left"/>
        </Grid>

        <!-- Пароль -->
        <Label Content="Пароль:" Grid.Row="3" Grid.Column="0"/>
        <Grid Grid.Row="3" Grid.Column="1" Margin="0,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Row="0" Grid.Column="0"
                     Height="23"
                     Text="{Binding Password, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            <Button Grid.Row="0" Grid.Column="1"
                    Content="Перегенерировать" 
                    Command="{Binding RegeneratePasswordCommand}" 
                    Width="120" 
                    Height="23" 
                    Margin="5,0,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="{Binding Errors[Password]}" 
                       Foreground="Red" 
                       FontSize="10" 
                       Margin="0,2,0,0"
                       HorizontalAlignment="Left"/>
        </Grid>

        <!-- Кнопки Сохранить и Отмена -->
        <StackPanel Orientation="Horizontal" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Command="{Binding SaveCommand}" IsEnabled="{Binding HasErrors, Converter={StaticResource InverseBooleanConverter}}" Width="80" Margin="0,0,10,0"/>
            <Button Content="Отмена" Command="{Binding CancelCommand}" Width="80"/>
        </StackPanel>
    </Grid>
</Window> 