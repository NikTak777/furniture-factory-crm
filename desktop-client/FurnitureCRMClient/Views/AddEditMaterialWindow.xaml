<Window x:Class="FurnitureCRMClient.Views.AddEditMaterialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FurnitureCRMClient.Views"
        xmlns:vm="clr-namespace:FurnitureCRMClient.ViewModels"
        mc:Ignorable="d"
        Title="Добавить/Редактировать Сырье" Height="250" Width="400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <!-- Стиль для TextBox и ComboBox без красной обводки при ошибках -->
        <Style TargetType="TextBox">
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <AdornedElementPlaceholder/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <AdornedElementPlaceholder/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Наименование материала -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Наименование:" Margin="0,0,10,5"/>
        <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBox Grid.Row="0" Height="23"
                     Text="{Binding Material.Наименование_материала, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            <TextBlock Grid.Row="1" Text="{Binding Errors[Наименование_материала]}"
                       Foreground="Red"
                       FontSize="10"
                       Margin="0,2,0,0"/>
        </Grid>

        <!-- Единица измерения -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Единица измерения:" Margin="0,0,10,5"/>
        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ComboBox Grid.Row="0" Height="23"
                      ItemsSource="{Binding AllowedUnits}"
                      SelectedItem="{Binding Material.Единица_измерения, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            <TextBlock Grid.Row="1" Text="{Binding Errors[Единица_измерения]}"
                       Foreground="Red"
                       FontSize="10"
                       Margin="0,2,0,0"/>
        </Grid>

        <!-- Количество в наличии -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Количество:" Margin="0,0,10,5"/>
        <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBox Grid.Row="0" Height="23"
                     Text="{Binding Material.Количество_в_наличии, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            <TextBlock Grid.Row="1" Text="{Binding Errors[Количество_в_наличии]}"
                       Foreground="Red"
                       FontSize="10"
                       Margin="0,2,0,0"/>
        </Grid>

        <!-- Кнопки сохранения и отмены -->
        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding HasErrors, Converter={StaticResource InverseBooleanConverter}}"
                    Width="80"
                    Margin="0,0,10,0"/>
            <Button Content="Отмена" Command="{Binding CancelCommand}" Width="80"/>
        </StackPanel>
    </Grid>
</Window>
