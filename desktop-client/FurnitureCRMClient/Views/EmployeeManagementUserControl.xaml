<UserControl x:Class="FurnitureCRMClient.Views.EmployeeManagementUserControl"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                 mc:Ignorable="d" 
                 d:DesignHeight="450" d:DesignWidth="800"
                 xmlns:local="clr-namespace:FurnitureCRMClient.Views">
    <UserControl.Resources>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
        <Style x:Key="CopyButtonStyle" TargetType="Button">
            <Setter Property="Content" Value="Копировать"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>
        <local:PasswordMaskConverter x:Key="PasswordMaskConverter" />
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Учёт сотрудников" Margin="0,0,0,10" Style="{StaticResource HeaderTextStyle}"/>

        <!-- Панель поиска и фильтрации -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Поиск по ФИО:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Width="200"
                     Height="23"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,16,0"/>

            <TextBlock Text="Должность:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Width="160"
                      Height="23"
                      ItemsSource="{Binding Positions}"
                      SelectedItem="{Binding SelectedPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Margin="0,0,16,0"/>

            <TextBlock Text="Статус:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Width="170"
                      Height="23"
                      ItemsSource="{Binding EmploymentStatuses}"
                      SelectedItem="{Binding SelectedEmploymentStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Margin="0,0,16,0"/>

            <Button Content="Очистить фильтры"
                    Width="140"
                    Click="ClearEmployeeFilters_Click"/>
        </StackPanel>

        <!-- Таблица для отображения сотрудников -->
        <DataGrid Grid.Row="2"
                  x:Name="EmployeesDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Margin="0,0,0,10"
                  ItemsSource="{Binding EmployeesView}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID Сотрудника" Binding="{Binding StaffId}" Width="*"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="2*"/>
                <DataGridTextColumn Header="Должность" Binding="{Binding Position}" Width="*"/>
                <DataGridTemplateColumn Header="Логин" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding UserAccount.Username}" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource CopyButtonStyle}" Click="CopyLogin_Click" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Пароль" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding UserAccount.Password, Converter={StaticResource PasswordMaskConverter}}" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource CopyButtonStyle}" Click="CopyPassword_Click" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопки для действий -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="AddEmployeeButton"
                    Content="Добавить"
                    Margin="0,0,10,0"
                    Click="AddEmployee_Click"/>
            <Button x:Name="EditEmployeeButton"
                    Content="Редактировать"
                    Margin="0,0,10,0"
                    Click="EditEmployee_Click"/>
            <Button x:Name="DeleteEmployeeButton"
                    Content="Удалить"
                    Margin="0,0,10,0"
                    Click="DeleteEmployee_Click"/>

            <!-- Для уволенных сотрудников показываем только кнопку возврата в штат -->
            <Button x:Name="RehireEmployeeButton"
                    Content="Вернуть в штат"
                    Click="RehireEmployee_Click"
                    Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</UserControl>