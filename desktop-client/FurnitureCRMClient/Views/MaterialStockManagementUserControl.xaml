<UserControl x:Class="FurnitureCRMClient.Views.MaterialStockManagementUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FurnitureCRMClient.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Учёт сырья на складе" Margin="0,0,0,10" Style="{StaticResource HeaderTextStyle}"/>

        <!-- Панель поиска и фильтрации -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Наименование:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Width="220"
                     Height="23"
                     Text="{Binding SearchName, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,16,0"/>

            <TextBlock Text="Ед. изм.:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Width="160"
                      Height="23"
                      ItemsSource="{Binding Units}"
                      SelectedItem="{Binding SelectedUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Margin="0,0,16,0"/>

            <TextBlock Text="Количество от:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Width="80"
                     Height="23"
                     Text="{Binding MinQuantityText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,8,0"/>

            <TextBlock Text="до:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Width="80"
                     Height="23"
                     Text="{Binding MaxQuantityText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,16,0"/>

            <Button Content="Очистить фильтры"
                    Width="150"
                    Click="ClearMaterialFilters_Click"/>
        </StackPanel>

        <!-- Таблица для отображения сырья -->
        <DataGrid Grid.Row="2" x:Name="MaterialDataGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,10" ItemsSource="{Binding MaterialsView}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Артикул" Binding="{Binding Артикул_сырья}" Width="*"/>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Наименование_материала}" Width="2*"/>
                <DataGridTextColumn Header="Единица измерения" Binding="{Binding Единица_измерения}" Width="*"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Количество_в_наличии}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопки для действий -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Добавить" Margin="0,0,10,0" Click="AddMaterial_Click"/>
            <Button Content="Редактировать" Click="EditMaterial_Click"/>
        </StackPanel>
    </Grid>
</UserControl> 