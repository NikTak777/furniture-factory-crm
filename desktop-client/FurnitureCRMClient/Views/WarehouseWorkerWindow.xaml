<Window x:Class="FurnitureCRMClient.Views.WarehouseWorkerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FurnitureCRMClient.Views"
        mc:Ignorable="d"
        Title="Панель Кладовщика" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl Margin="10" Grid.Row="0">
            <TabItem Header="Учёт сырья на складе">
                <ContentControl x:Name="MaterialStockManagementContent" />
            </TabItem>
            <TabItem Header="Оформление закупки сырья">
                <ContentControl x:Name="MaterialPurchaseOrderContent" />
            </TabItem>
            <TabItem Header="Анализ потребности в материалах">
                <ContentControl x:Name="MaterialNeedsAnalysisContent" />
            </TabItem>
        </TabControl>
        <Button Content="Выйти"
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Height="38"
                Margin="18,0,18,18"
                Click="LogoutButton_Click" />
    </Grid>
</Window> 