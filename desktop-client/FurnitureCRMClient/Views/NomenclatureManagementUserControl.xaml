<UserControl x:Class="FurnitureCRMClient.Views.NomenclatureManagementUserControl"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                 mc:Ignorable="d" 
                 d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Учёт номенклатуры" Margin="0,0,0,10" Style="{StaticResource HeaderTextStyle}"/>

        <!-- Панель поиска и фильтрации -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Наименование:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Width="180"
                     Height="23"
                     Text="{Binding SearchName, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,16,0"/>

            <TextBlock Text="Категория:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Width="150"
                      Height="23"
                      ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Margin="0,0,16,0"/>

            <TextBlock Text="Стоимость от:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Width="70"
                     Height="23"
                     Text="{Binding MinPriceText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,8,0"/>

            <TextBlock Text="до:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Width="70"
                     Height="23"
                     Text="{Binding MaxPriceText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,16,0"/>

            <TextBlock Text="Статус:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Width="160"
                      Height="23"
                      ItemsSource="{Binding ProductionStatuses}"
                      SelectedItem="{Binding SelectedProductionStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Margin="0,0,16,0"/>

            <Button Content="Очистить фильтры"
                    Width="140"
                    Click="ClearNomenclatureFilters_Click"/>
        </StackPanel>

        <!-- Таблица для отображения номенклатуры -->
        <DataGrid Grid.Row="2" x:Name="NomenclatureDataGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,10" ItemsSource="{Binding NomenclaturesView}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Артикул" Binding="{Binding Артикул_товара}" Width="*"/>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Наименование}" Width="2*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Категория}" Width="*"/>
                <DataGridTextColumn Header="Цвет" Binding="{Binding Цвет}" Width="*"/>
                <DataGridTextColumn Header="Размеры" Binding="{Binding Размеры}" Width="*"/>
                <DataGridTextColumn Header="Стоимость" Binding="{Binding Стоимость}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопки для действий -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="AddNomenclatureButton"
                    Content="Добавить"
                    Margin="0,0,10,0"
                    Click="AddNomenclature_Click"/>
            <Button x:Name="EditNomenclatureButton"
                    Content="Редактировать"
                    Margin="0,0,10,0"
                    Click="EditNomenclature_Click"/>
            <Button x:Name="DeleteNomenclatureButton"
                    Content="Удалить"
                    Margin="0,0,10,0"
                    Click="DeleteNomenclature_Click"/>

            <!-- Для снятой с производства номенклатуры показываем только кнопку возврата в производство -->
            <Button x:Name="ReinstateNomenclatureButton"
                    Content="Вернуть в производство"
                    Click="ReinstateNomenclature_Click"
                    Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</UserControl>