<Window x:Class="FurnitureCRMClient.Views.AddEditClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Добавить/Редактировать клиента" Height="350" Width="400"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Стиль для TextBox без красной обводки при ошибках -->
        <Style TargetType="TextBox">
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <AdornedElementPlaceholder/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ФИО -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="ФИО:" Margin="0,0,10,5"/>
        <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBox Grid.Row="0" Height="23"
                     Text="{Binding Client.FullName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            <TextBlock Grid.Row="1" Text="{Binding Errors[Client.FullName]}" Foreground="Red" FontSize="10" Margin="0,2,0,0"/>
        </Grid>

        <!-- Номер телефона -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Телефон:" Margin="0,0,10,5"/>
        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBox Grid.Row="0" Height="23"
                     Text="{Binding PhoneText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            <TextBlock Grid.Row="1" Text="{Binding Errors[PhoneText]}" Foreground="Red" FontSize="10" Margin="0,2,0,0"/>
        </Grid>

        <!-- Email -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Email:" Margin="0,0,10,5"/>
        <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBox Grid.Row="0" Height="23"
                     Text="{Binding Client.Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            <TextBlock Grid.Row="1" Text="{Binding Errors[Client.Email]}" Foreground="Red" FontSize="10" Margin="0,2,0,0"/>
        </Grid>

        <!-- Адрес -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Адрес:" Margin="0,0,10,5"/>
        <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBox Grid.Row="0" Height="23"
                     Text="{Binding Client.Address, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            <TextBlock Grid.Row="1" Text="{Binding Errors[Client.Address]}" Foreground="Red" FontSize="10" Margin="0,2,0,0"/>
        </Grid>
        
        <!-- Дата регистрации (только для чтения в режиме редактирования) - вынесена из основной сетки -->
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock Text="Дата регистрации:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding Client.RegistrationDate, StringFormat='dd.MM.yyyy'}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Command="{Binding SaveCommand}" Width="80" Margin="0,0,10,0"/>
            <Button Content="Отмена" Command="{Binding CancelCommand}" Width="80"/>
        </StackPanel>
    </Grid>
</Window>
