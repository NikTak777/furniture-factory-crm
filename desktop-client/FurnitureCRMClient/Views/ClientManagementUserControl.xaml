<UserControl x:Class="FurnitureCRMClient.Views.ClientManagementUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Учёт клиентов" Margin="0,0,0,10" Style="{StaticResource HeaderTextStyle}"/>

        <!-- Панель поиска и фильтрации -->
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="ФИО:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Width="220"
                         Height="23"
                         Text="{Binding SearchFullName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,16,0"/>

                <TextBlock Text="Телефон:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Width="150"
                         Height="23"
                         Text="{Binding SearchPhone, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,16,0"/>

                <TextBlock Text="Email:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Width="200"
                         Height="23"
                         Text="{Binding SearchEmail, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Адрес:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Width="260"
                         Height="23"
                         Text="{Binding SearchAddress, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,16,0"/>

                <TextBlock Text="Дата регистрации от:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker Width="140"
                            Height="23"
                            SelectedDate="{Binding RegistrationDateFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,0,8,0"/>
                <TextBlock Text="до:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker Width="140"
                            Height="23"
                            SelectedDate="{Binding RegistrationDateTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,0,16,0"/>

                <Button Content="Очистить фильтры"
                        Width="150"
                        Click="ClearClientFilters_Click"/>
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="ClientsDataGrid" 
                  Grid.Row="2" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True" 
                  Margin="0,0,0,10"
                  ItemsSource="{Binding ClientsView}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID клиента" Binding="{Binding Id}" Width="*"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Номер телефона" Binding="{Binding Phone}" Width="*"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="*"/>
                <DataGridTextColumn Header="Дата регистрации" Binding="{Binding RegistrationDate, StringFormat='dd.MM.yyyy'}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="Добавить" Margin="0,0,10,0" Click="AddClient_Click"/>
            <Button Content="Редактировать" Margin="0,0,10,0" Click="EditClient_Click"/>
            <Button Content="Удалить" Click="DeleteClient_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
