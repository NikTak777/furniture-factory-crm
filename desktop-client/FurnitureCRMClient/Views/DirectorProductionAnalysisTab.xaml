<UserControl x:Class="FurnitureCRMClient.Views.DirectorProductionAnalysisTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:oxy="http://oxyplot.org/wpf"
    xmlns:local="clr-namespace:FurnitureCRMClient.Views"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        <Style x:Key="SummaryLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,2,20,2"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Заголовок -->
            <RowDefinition Height="Auto"/>  <!-- Кнопка открытия отчёта -->
            <RowDefinition Height="Auto"/>  <!-- Сводка -->
            <RowDefinition Height="2*" MinHeight="350" MaxHeight="800"/>    <!-- Таблица заказов -->
            <RowDefinition Height="Auto"/>  <!-- Перетаскиваемая граница -->
            <RowDefinition Height="3*" MinHeight="220"/>    <!-- Диаграммы -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Анализ отчётов о производстве" Margin="0,0,0,10" Style="{StaticResource HeaderTextStyle}"/>

        <!-- Кнопка открытия файла -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Открыть отчёт" Click="OpenReport_Click" Padding="10,3" Margin="0,0,10,0"/>
            <TextBlock x:Name="ReportInfoText" VerticalAlignment="Center" FontStyle="Italic" Foreground="Gray"/>
        </StackPanel>

        <!-- Сводка -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock x:Name="TotalOrdersText" Style="{StaticResource SummaryLabelStyle}"/>
            <TextBlock x:Name="InProcessingText" Style="{StaticResource SummaryLabelStyle}"/>
            <TextBlock x:Name="InProductionText" Style="{StaticResource SummaryLabelStyle}"/>
            <TextBlock x:Name="CompletedText" Style="{StaticResource SummaryLabelStyle}"/>
            <TextBlock x:Name="CancelledText" Style="{StaticResource SummaryLabelStyle}"/>
            <TextBlock x:Name="TotalRevenueText" Style="{StaticResource SummaryLabelStyle}"/>
        </StackPanel>

        <!-- Таблица заказов -->
        <DataGrid Grid.Row="3"
                  x:Name="OrdersDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Margin="0,0,0,10"
                  ItemsSource="{Binding Orders}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер заказа" Binding="{Binding OrderId}" Width="Auto"/>
                <DataGridTextColumn Header="Дата оформления" Binding="{Binding OrderDate, StringFormat='{}{0:dd.MM.yyyy}'}" Width="Auto"/>
                <DataGridTextColumn Header="Наименование товара" Binding="{Binding ProductName}" Width="2*"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="Auto"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="Auto"/>
                <DataGridTextColumn Header="Итоговая стоимость" Binding="{Binding TotalPrice}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Перетаскиваемая граница между таблицей и диаграммами -->
        <GridSplitter Grid.Row="4"
                      Height="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="#FFE0E0E0"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True"/>

        <!-- Графики -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- График по статусам -->
            <Grid Grid.Column="0" Margin="0,0,10,0" x:Name="StatusChartGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Распределение заказов по статусам" 
                           Style="{StaticResource SectionHeaderStyle}"
                           Visibility="{Binding Orders.Count, Converter={StaticResource CountToVisibilityConverter}}"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Левая колонка под диаграмму (ширина задаётся самим PlotView) -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Правая колонка под легенду по содержимому -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <oxy:PlotView x:Name="StatusPiePlot" 
                                  Grid.Column="0" 
                                  Margin="0,0,10,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Stretch"
                                  MinHeight="150"
                                  Width="{Binding ElementName=StatusChartGrid, Path=ActualHeight}"/>
                    <ItemsControl x:Name="StatusLegend"
                                  Grid.Column="1"
                                  ItemsSource="{Binding LegendItems}"
                                  VerticalAlignment="Center"
                                  Margin="0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Rectangle Width="16"
                                               Height="16"
                                               Fill="{Binding Color}"
                                               Stroke="Black"
                                               StrokeThickness="0.5"
                                               Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>

            <!-- График по товарам -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Топ-5 товаров по выручке" 
                           Style="{StaticResource SectionHeaderStyle}"
                           Visibility="{Binding Orders.Count, Converter={StaticResource CountToVisibilityConverter}}"/>

                <oxy:PlotView Grid.Row="1"
                              x:Name="ProductsBarPlot"
                              Margin="0,4,0,0"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              MinHeight="150"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
